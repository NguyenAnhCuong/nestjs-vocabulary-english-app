generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


// ─────────────────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────────────────

enum Role {
  USER
  ADMIN
}

enum CefrLevel {
  A1
  A2
  B1
  B2
  C1
  C2
}

enum WordType {
  NOUN
  VERB
  ADJECTIVE
  ADVERB
  PHRASE
  CONJUNCTION
  PREPOSITION
  PRONOUN
}

enum LearningSource {
  SYSTEM
  MANUAL
  IMPORT
}

enum MemoryStatus {
  NEW
  LEARNING
  REVIEWING
  MASTERED
}

// ✅ XOÁ enum QuizResult — không còn dùng (QuizAnswer model đã bỏ)

enum QuestionType {
  pronunciation
  vocabulary
  reading_blank
}


model User {
  id             String          @id @default(uuid())
  name           String?
  email          String          @unique
  gender         String?
  age            Int?
  address        String?
  refreshToken   String?
  role           Role            @default(USER)
  createdBy      Json?
  updatedBy      Json?
  deletedBy      Json?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  isDeleted      Boolean         @default(false)
  deletedAt      DateTime?
  password       String?
  googleId       String?         @unique
  avatarUrl      String?
  provider       String          @default("LOCAL")
  favourites     Favourite[]
  importExports  ImportExport[]
  learningConfig LearningConfig?
  notifications  Notification[]
  quizAttempts   QuizAttempt[]
  studySessions  StudySession[]
  goals          UserGoal[]
  userWords      UserWord[]
  wordProgress   WordProgress[]

  @@map("users")
}

model LearningConfig {
  id                 String    @id @default(uuid())
  userId             String    @unique
  dailyNewWordTarget Int       @default(10)
  dailyMinuteTarget  Int       @default(30)
  currentLevel       CefrLevel @default(A1)
  targetLevel        CefrLevel @default(B2)
  reminderTime       String?
  notificationsOn    Boolean   @default(true)
  uiLanguage         String    @default("vi")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("learning_configs")
}

model Topic {
  id          String      @id @default(uuid())
  name        String      @unique
  nameEn      String?
  emoji       String?
  color       String?
  description String?
  sortOrder   Int         @default(0)
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  wordTopics  WordTopic[]

  @@map("topics")
}

model Word {
  id           String         @id @default(uuid())
  en           String         @unique
  phonetic     String?
  type         WordType
  level        CefrLevel
  meaning      String
  meaningEn    String?
  example      String?
  exampleVi    String?
  audioUrl     String?
  imageUrl     String?
  tags         String[]
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  favourites   Favourite[]
  // ✅ XOÁ quan hệ quizQuestions — QuizQuestion mới không có wordId
  wordProgress WordProgress[]
  wordTopics   WordTopic[]

  @@index([level])
  @@index([type])
  @@map("words")
}

model WordTopic {
  wordId  String
  topicId String
  topic   Topic  @relation(fields: [topicId], references: [id], onDelete: Cascade)
  word    Word   @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@id([wordId, topicId])
  @@map("word_topics")
}

model UserWord {
  id           String        @id @default(uuid())
  userId       String
  en           String
  phonetic     String?
  type         WordType      @default(NOUN)
  level        CefrLevel     @default(B1)
  meaning      String
  example      String?
  note         String?
  source       String?
  imageUrl     String?
  audioUrl     String?
  isDeleted    Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?
  favourites   Favourite[]
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  wordProgress WordProgress?

  @@index([userId])
  @@map("user_words")
}

model WordProgress {
  id             String         @id @default(uuid())
  userId         String
  wordId         String?
  userWordId     String?        @unique
  source         LearningSource @default(SYSTEM)
  status         MemoryStatus   @default(NEW)
  repetitions    Int            @default(0)
  easeFactor     Float          @default(2.5)
  intervalDays   Int            @default(1)
  nextReviewAt   DateTime       @default(now())
  correctCount   Int            @default(0)
  wrongCount     Int            @default(0)
  lastReviewedAt DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userWord       UserWord?      @relation(fields: [userWordId], references: [id])
  word           Word?          @relation(fields: [wordId], references: [id])

  @@unique([userId, wordId])
  @@index([userId, status])
  @@index([userId, nextReviewAt])
  @@map("word_progress")
}

model Favourite {
  id         String    @id @default(uuid())
  userId     String
  wordId     String?
  userWordId String?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userWord   UserWord? @relation(fields: [userWordId], references: [id], onDelete: Cascade)
  word       Word?     @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@unique([userId, wordId])
  @@unique([userId, userWordId])
  @@map("favourites")
}

model StudySession {
  id            String   @id @default(uuid())
  userId        String
  studyDate     DateTime @db.Date
  durationSecs  Int      @default(0)
  newWordsCount Int      @default(0)
  reviewCount   Int      @default(0)
  xpEarned      Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, studyDate])
  @@index([userId, studyDate])
  @@map("study_sessions")
}

model UserGoal {
  id           String    @id @default(uuid())
  userId       String
  goalType     String
  targetValue  Int
  currentValue Int       @default(0)
  isCompleted  Boolean   @default(false)
  completedAt  DateTime?
  goalDate     DateTime? @db.Date
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, goalType, goalDate])
  @@map("user_goals")
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  type      String
  title     String
  body      String
  isRead    Boolean   @default(false)
  readAt    DateTime?
  metadata  Json?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

model ImportExport {
  id        String   @id @default(uuid())
  userId    String
  direction String
  format    String
  fileName  String?
  wordCount Int      @default(0)
  status    String   @default("pending")
  errorLog  String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("import_exports")
}

// ─────────────────────────────────────────────────────────────────────────────
// QUIZ SYSTEM
// ─────────────────────────────────────────────────────────────────────────────

/// Bài quiz (admin tạo)
model Quiz {
  id              String    @id @default(uuid())
  title           String
  description     String    @default("")
  level           CefrLevel
  durationMinutes Int       @default(30)
  totalQuestions  Int       @default(21)
  tags            String[]  @default([])
  isPublished     Boolean   @default(false)
  /// ✅ String? — nullable vì seed chạy không có user
  createdBy       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  questions QuizQuestion[]
  attempts  QuizAttempt[]

  @@index([level])
  @@index([isPublished])
  @@map("quizzes")
}

/// Câu hỏi trong quiz — 3 loại: phát âm | từ vựng | đọc hiểu
model QuizQuestion {
  id          String       @id @default(uuid())
  quizId      String
  type        QuestionType
  order       Int
  question    String
  /// Chỉ dùng cho reading_blank: đoạn văn có [BLANK1], [BLANK2]…
  passage     String?
  /// Pronunciation & vocabulary: 4 options; reading_blank: []
  options     String[]     @default([])
  /// Pronunciation & vocabulary: đáp án đúng; reading_blank: ""
  answer      String       @default("")
  explanation String       @default("")
  /// Metadata: { phonetics: ["/beər/",...] } hoặc { title: "Bài đọc:..." }
  meta        Json?
  createdAt   DateTime     @default(now())

  quiz   Quiz          @relation(fields: [quizId], references: [id], onDelete: Cascade)
  blanks ReadingBlank[]

  @@index([quizId])
  @@index([quizId, type])
  @@map("quiz_questions")
}

/// Chỗ trống trong câu đọc hiểu
model ReadingBlank {
  id         String   @id @default(uuid())
  questionId String
  label      String
  options    String[]
  answer     String
  order      Int

  question QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@map("reading_blanks")
}

/// Lượt làm bài của user
model QuizAttempt {
  id               String   @id @default(uuid())
  quizId           String
  userId           String
  /// Map: questionId | blankId → đáp án user chọn
  answers          Json
  /// QuizScore object (khớp với frontend type)
  score            Json
  timeTakenSeconds Int      @default(0)
  submittedAt      DateTime @default(now())

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([quizId])
  @@index([userId])
  @@index([quizId, userId])
  @@map("quiz_attempts")
}
